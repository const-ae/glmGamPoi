Bootstrap: docker
From: archlinux

%setup
mkdir -p "${SINGULARITY_ROOTFS}/workdir/glmGamPoi2"
mkdir "${SINGULARITY_ROOTFS}/workdir/glmGamPoi2/R"
mkdir "${SINGULARITY_ROOTFS}/workdir/glmGamPoi2/src"
mkdir -p "${SINGULARITY_ROOTFS}/workdir/glmGamPoi2/inst/include"
mkdir -p "${SINGULARITY_ROOTFS}/workdir/glmGamPoi2/inst/include/LBFGSpp/include"
mkdir -p "${SINGULARITY_ROOTFS}/workdir/glmGamPoi2/tests/testthat"

%files
./DESCRIPTION /workdir/glmGamPoi2/DESCRIPTION
./R/*.R /workdir/glmGamPoi2/R
./src/*.cpp /workdir/glmGamPoi2/src
./src/Makevars /workdir/glmGamPoi2/src
./inst/include/*.h /workdir/glmGamPoi2/inst/include
./inst/include/LBFGSpp/include/* /workdir/glmGamPoi2/inst/include/LBFGSpp/include
./tests/testthat.R /workdir/glmGamPoi2/inst/tests/testthat.R
./tests/testthat/*.R /workdir/glmGamPoi2/tests/testthat

%post
cd '/workdir/glmGamPoi2'

pacman -Syu --noconfirm && \
	pacman -S zlib-ng-compat <<< $'y\n' && \
	pacman -S --noconfirm \
		perf heaptrack \ # optional deps here
		base-devel git linux-headers cmake gcc gcc-fortran lld openmp \
		libuv libgit2 curl libxml2 curl \
		fontconfig fribidi harfbuzz freetype2 \
		libjpeg-turbo libpng libtiff \
		blas-openblas r

echo '# Generated by roxygen2: do not edit by hand' > ./NAMESPACE

export PKG_SYSREQS=FALSE

Rscript /dev/stdin <<'EOF'
	install.packages("pak", repos = sprintf("https://r-lib.github.io/p/pak/stable/%s/%s/%s", .Platform[["pkgType"]], R.Version()[["os"]], R.Version()[["arch"]]))

	pak::pak(c("bioc::glmGamPoi?source=true", "roxygen2", "pkgbuild"))
	pak::local_install_dev_deps("./")

	pak::pak(c("data.table", "Matrix", "bioc::SingleCellExperiment", "testthat"))

	shared_flags <- "-fuse-ld=lld -flto -ffat-lto-objects -fopenmp"
	withr::with_makevars(assignment = "=", c(
		CXX17STD = "-std=c++17",
		CXX17FLAGS = sprintf("%s -O3 -march=native", shared_flags),
		LDFLAGS = sprintf("%s -L/usr/lib64/R/lib -Wl,-O2 -Wl,--sort-common -Wl,--as-needed -Wl,-z,relro -Wl,-z,now -Wl,-z,pack-relative-relocs", shared_flags)
	), {
		roxygen2::roxygenize(clean = TRUE)
		pkgbuild::clean_dll()
		Rcpp::compileAttributes()
		install.packages("./", repos = NULL, type = "source")
	})
EOF

%test
R -q -e 'testthat::test_local("/workdir/glmGamPoi2", stop_on_failure = TRUE, load_package = "installed")'

%runscript
cd '/workdir/glmGamPoi2'
exec '/bin/bash' -c "$@"
